# AI Visibility Action Layer — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon or Cloud SQL PostgreSQL connection string
DATABASE_URL=postgresql://localhost:5432/ai_visibility

# ─── Google Search Console ────────────────────────────────────────────────────
# Service account with webmasters.readonly scope
# Type: "domain property" uses sc-domain: prefix
GSC_SITE_URL=sc-domain:example.com
GSC_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
your-key-here
-----END PRIVATE KEY-----"

# ─── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project
GCP_LOCATION=europe-west1

# ─── Cloud Tasks ──────────────────────────────────────────────────────────────
CLOUD_TASKS_QUEUE=ai-visibility-jobs
WORKER_URL=http://localhost:8080

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=4000

# ─── GitHub App (Slice 1) ─────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=

# ─── Stripe (Slice 8 — future) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
